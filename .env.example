# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoIQ?schema=public
# Puerto de la app
PORT=3000
# Entorno
NODE_ENV=development

# JWT (reemplazar por valores largos y únicos en producción)
JWT_AUTH_SECRET=changeme_auth_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_RESET_SECRET=changeme_reset_secret

# Mail (ejemplo: Mailtrap sandbox)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mailtrap_user
MAIL_PASS=your_mailtrap_pass
MAIL_FROM="Gestor de ventas <no-reply@gestorventas.local>"

# Opcional (Azure/GitHub Actions) - no guardar secretos reales aquí
# Para despliegue con publish profile puedes usar el secret AZURE_WEBAPP_PUBLISH_PROFILE en GitHub.
# Para Service Principal (azure/login) usa AZURE_CREDENTIALS (JSON) en GitHub Secrets.
# AZURE_WEBAPP_PUBLISH_PROFILE=
# AZURE_CREDENTIALS=
