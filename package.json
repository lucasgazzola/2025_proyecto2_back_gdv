{
  "name": "2025_proyecto2_back_gdv",
  "version": "0.1.0",
  "description": "",
  "main": "dist/src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=dev nodemon --watch src -e ts --exec \"ts-node -r tsconfig-paths/register src/server.ts\"",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "prisma:resetdb": "npx prisma migrate reset --force && npx prisma migrate dev --name init",
    "prisma:push:test": "cross-env DATABASE_URL=\"$(sed -n 's/^DATABASE_URL=//p' .env.test)\" npx prisma db push",
    "test:inBand": "cross-env NODE_ENV=test jest --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand",
    "azure:deploy": "npm install && npm run build && npm start dist/src/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.17.0",
    "@types/supertest": "^6.0.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "install": "^0.13.0",
    "jsonwebtoken": "^9.0.2",
    "npm": "^11.6.1",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.0",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.17.0",
    "tsconfig-paths": "^4.2.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
